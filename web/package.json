{
  "name": "@wordsvelte/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "dev:cf": "vite build && wrangler pages dev .svelte-kit/cloudflare --d1 DB=wordsvelte-db --r2 R2=wordsvelte-media",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler pages deploy .svelte-kit/cloudflare",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "svelte-kit sync && tsc --noEmit"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.17.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@wordsvelte/shared": "*",
    "adm-zip": "^0.5.17",
    "better-sqlite3": "^12.10.0",
    "ckeditor5": "^48.2.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^4.5.0",
    "handlebars": "^4.7.9",
    "jose": "^6.2.3",
    "mode-watcher": "^1.1.0",
    "sanitize-html": "^2.18.1",
    "simple-icons": "^16.23.0",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/kit": "^2.64.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@types/adm-zip": "^0.5.8",
    "@types/sanitize-html": "^2.16.2",
    "bits-ui": "^2.18.1",
    "drizzle-kit": "^0.31.10",
    "svelte": "^5.17.0",
    "svelte-check": "^4.7.6",
    "tailwind-variants": "^3.2.2",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.99.0"
  },
  "type": "module",
  "license": "MIT"
}
